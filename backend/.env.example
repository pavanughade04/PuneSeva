PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_local_mysql_password
DB_NAME=pune_seva
# Remote production MySQL connections use TLS automatically; set true to test TLS locally.
DB_SSL=false

# Set a random value of at least 32 characters for persistent sessions.
SESSION_SECRET=

# Set a private random path for admin sign-in; production requires at least 24 characters.
ADMIN_LOGIN_PATH=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# First admin account setup (development only)
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_min_12_characters