
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgresql_password
DB_NAME=PuneSeva
DB_SSL=false

# Session Security
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Admin Login
ADMIN_LOGIN_PATH=/your-private-admin-login-path

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Admin Account (Development Only)
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_min_12_characters